# Variables d'environnement par défaut (committées, non sensibles).
# Surchargées en local via .env.local (non versionné).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Valeur réelle dans .env.local (contient le mot de passe BDD).
DATABASE_URL=
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> docker compose ###
# Variables non sensibles uniquement (db name, user, ports).
# Les mots de passe (MYSQL_PASSWORD, MYSQL_ROOT_PASSWORD) sont dans .env.local.
# docker-compose.yml charge .env + .env.local via env_file pour les services qui en ont besoin.
MYSQL_DATABASE=spliteasy
MYSQL_USER=spliteasy
NGINX_HTTP_PORT=8080
DB_HOST_PORT=3306
PMA_HOST_PORT=8081
###< docker compose ###

###> symfony/mailer ###
MAILER_DSN=smtp://localhost:1025
###< symfony/mailer ###

###> spliteasy/mindee ###
MINDEE_API_KEY=
###< spliteasy/mindee ###

###> spliteasy/ocr-space ###
# Clé gratuite via inscription email sur https://ocr.space/ocrapi (25000 requetes/mois).
OCR_SPACE_API_KEY=
###< spliteasy/ocr-space ###
