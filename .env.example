# ============================================================
# split-easy-api — variables sensibles (template).
#
# Copier ce fichier vers .env.local (jamais commité) et renseigner
# les valeurs. docker-compose charge .env puis .env.local (override)
# via env_file pour les services app, db et phpmyadmin.
#
# .env (commité)       → variables non sensibles : ports, db name, user
# .env.local (ignoré)  → mots de passe, secrets, clés API
# ============================================================

# ----- MySQL secrets -----
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ----- Symfony -----
APP_SECRET=
DATABASE_URL="mysql://spliteasy:<MYSQL_PASSWORD>@db:3306/spliteasy?serverVersion=8.0&charset=utf8mb4"

# ----- JWT (LexikJWTAuthenticationBundle) -----
JWT_PASSPHRASE=

# ----- phpMyAdmin (auto-login en dev) -----
PMA_USER=spliteasy
PMA_PASSWORD=

# ----- Mindee OCR -----
MINDEE_API_KEY=
